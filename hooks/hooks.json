{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/git-readonly-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/design-state-reload.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/design-state-reload.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/design-state-reload.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/design-state-reload.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "If a /dotnet-refactor design loop is active, write any unpersisted map/trace/probe/decision state to its .episteme/DESIGN-*.md file before compaction, and update its frontmatter phase/status to the current position."
          }
        ]
      },
      {
        "matcher": "manual",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "If a /dotnet-refactor design loop is active, write any unpersisted map/trace/probe/decision state to its .episteme/DESIGN-*.md file before compaction, and update its frontmatter phase/status to the current position."
          }
        ]
      }
    ]
  }
}
